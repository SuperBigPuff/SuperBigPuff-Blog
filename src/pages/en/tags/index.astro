---
import { getBlogCollection, getUniqueTagsWithCount } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import { cn, getBlogIndexPath, getPostsByLocale, getTagPath, ui } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'

const locale = 'en'
const allPosts = getPostsByLocale(await getBlogCollection(), locale)
const allTags = getUniqueTagsWithCount(allPosts)

const meta = {
  description: ui[locale].tagsPage.description,
  title: ui[locale].tagsPage.title
}
---

<PageLayout {meta}>
  <Button title={ui[locale].common.back} href={getBlogIndexPath(locale)} variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>{ui[locale].tagsPage.title}</h1>
    </div>

    <div id='content' class='animate'>
      {
        allTags.length > 0 ? (
          <ul class='flex flex-wrap gap-4'>
            {allTags.map(([tag, val]) => (
              <li>
                <Button
                  href={getTagPath(tag, locale)}
                  variant='pill'
                  class={cn(
                    'items-start gap-x-1',
                    val > 2 ? 'rounded-xl px-3 py-1 text-xl' : val > 1 && 'text-lg'
                  )}
                >
                  {tag}
                  <span class={val > 2 ? 'text-base' : 'text-xs'}>{val}</span>
                </Button>
              </li>
            ))}
          </ul>
        ) : (
          <p>{ui[locale].tagsPage.empty}</p>
        )
      }
    </div>
  </main>
</PageLayout>
