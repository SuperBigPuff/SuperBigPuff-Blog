---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview } from 'astro-pure/components/pages'
import {
  getBlogCollection,
  getCollectionsByCategory,
  getUniqueCategories,
  getUniqueTagsWithCount,
  sortMDByDate
} from 'astro-pure/server'
import { Button, Icon } from 'astro-pure/user'
import { getArchivesPath, getPostsByLocale, getTagPath, ui } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

export const prerender = true

const locale = 'zh'

export const getStaticPaths = (async ({ paginate }) => {
  const routeLocale = 'zh'
  const categoryOrder = ['Research', 'Technical', 'Daily', 'Essays']
  const allPosts = getPostsByLocale(await getBlogCollection(), routeLocale)
  const allCategories = getUniqueCategories(allPosts)
  const categoryLookup = new Map(allCategories.map((c) => [c.toLowerCase(), c] as const))
  const categories = categoryOrder
    .map((c) => categoryLookup.get(c.toLowerCase()))
    .filter((c): c is string => Boolean(c))

  return categories.flatMap((category) => {
    const posts = sortMDByDate(getCollectionsByCategory(allPosts, category))
    const uniqueTags = getUniqueTagsWithCount(posts).map(([tag]) => tag)

    return paginate(posts, {
      params: { category },
      pageSize: config.content.blogPageSize,
      props: { category, uniqueTags, collectionsCount: posts.length }
    })
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  category: string
  uniqueTags: string[]
  collectionsCount: number
}

const { page, category, uniqueTags, collectionsCount } = Astro.props as Props
const categoryDisplayName =
  ui[locale].categories[category as keyof typeof ui[typeof locale]['categories']] || category

const meta = {
  description: ui[locale].blog.categoryDescription(categoryDisplayName),
  title: `${categoryDisplayName} - Blog`
}

const paginationProps = {
  ...(page.url.prev && { prevUrl: { text: ui[locale].blog.prev, url: page.url.prev } }),
  ...(page.url.next && { nextUrl: { text: ui[locale].blog.next, url: page.url.next } })
}
---

<PageLayout {meta}>
  <Button title={ui[locale].common.back} href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 mt-6 text-3xl font-medium sm:mt-10'>{categoryDisplayName}</h1>
    </div>

    <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
      <section aria-label='Blog posts list' class='animate' id='content'>
        <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
          <span class='text-muted-foreground'>
            {ui[locale].blog.pageStatus(page.currentPage, page.data.length, collectionsCount)}
          </span>
          <a href={getArchivesPath(locale)} data-astro-prefetch>{ui[locale].blog.archives}</a>
        </div>

        <ul class='flex flex-col gap-y-4 text-start'>
          {page.data.map((post) => (
            <PostPreview {post} detailed />
          ))}
        </ul>

        <Paginator {...paginationProps} />
      </section>

      {!!uniqueTags.length && (
        <aside class='animate' id='sidebar'>
          <h2 class='mb-4 flex items-center text-lg font-medium'>
            <Icon name='tag-2' class='me-2' />
            {ui[locale].blog.tags}
          </h2>
          <ul class='text-bgColor flex flex-wrap gap-2'>
            {uniqueTags.slice(0, 50).map((tag) => (
              <li><Button title={tag} href={getTagPath(tag, locale)} variant='pill' /></li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </main>
</PageLayout>
